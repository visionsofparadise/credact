{
	"name": "credact",
	"version": "0.1.0",
	"description": "Inject credentials into a child process and redact them from its output",
	"type": "module",
	"bin": {
		"credact": "dist/credact.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "Matt Cavender",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/visionsofparadise/credact.git"
	},
	"scripts": {
		"prepare": "node -e \"import('node:child_process').then(({execSync})=>{try{execSync('git rev-parse --is-inside-work-tree',{stdio:'ignore'});execSync('git config core.hooksPath .githooks')}catch{}})\" && node tools.mjs install",
		"fix": "concurrently -m 1 --group \"prettier --write .\" \"eslint . --fix --cache\" \"markdownlint-cli2 --fix \\\"**/*.md\\\"\" \"textlint --fix \\\"**/*.md\\\"\"",
		"check": "concurrently --group \"prettier --check .\" \"eslint . --no-cache -f unix\" \"tsc --noEmit --pretty false\" \"markdownlint-cli2 \\\"**/*.md\\\"\" \"textlint -f compact \\\"**/*.md\\\"\" \"knip --no-progress\" \"jscpd .\" \"node tools.mjs run actionlint\"",
		"unit": "vitest run unit",
		"build:npm": "tsup src/credact.ts --format esm --target node22 --clean",
		"build:exe": "node build.mjs",
		"build": "npm run build:npm && npm run build:exe",
		"smoke": "node smoke.mjs"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@html-eslint/eslint-plugin": "^0.65.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/cross-spawn": "^6.0.6",
		"@types/node": "^26.4.1",
		"bun": "^1.4.1",
		"concurrently": "^10.0.5",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-formatter-unix": "^9.0.1",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-barrel-files": "^3.0.1",
		"eslint-plugin-comment-rules": "^0.1.7",
		"eslint-plugin-import-x": "^4.17.1",
		"globals": "^17.12.0",
		"jscpd": "^5.1.2",
		"knip": "^6.34.0",
		"markdownlint-cli2": "^0.23.2",
		"prettier": "^3.9.6",
		"textlint": "^15.8.0",
		"textlint-filter-rule-comments": "^1.3.0",
		"textlint-rule-no-dead-link": "^6.2.3",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@noble/ciphers": "^2.4.0",
		"cross-spawn": "^7.0.6"
	},
	"allowScripts": {
		"bun@1.4.1": true
	}
}
